# =========================================
#  Template — copy to `.env` and fill.
#  VITE_ vars are exposed to the browser (public).
#  Backend secret (VERIFIER_PRIVATE_KEY) is used
#  ONLY by api/verify.js and should be set in
#  Vercel Environment Variables — NEVER in git.
# =========================================

# --- Frontend (public) ---
VITE_THIRDWEB_CLIENT_ID=YOUR_THIRDWEB_CLIENT_ID
VITE_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# --- Backend (serverless /api/verify.js) ---
GALXE_API_TOKEN=YOUR_GALXE_TOKEN
GALXE_QUEST_ID=GCTrRtZmii
VERIFIER_PRIVATE_KEY=YOUR_VERIFIER_PRIVATE_KEY
# AI key for the /api/tweet generator (Anymodel / OpenAI-compatible):
ANYMODEL_API_KEY=YOUR_ANYMODEL_API_KEY
# optional if not matching the built-in default:
CONTRACT_ADDRESS=0x68B3F95f2ebF0D69F224fc80b1839de02Fabc757